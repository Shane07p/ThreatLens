# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://threatlens:threatlens@localhost:5432/threatlens
THREATLENS_TEST_DSN=postgresql://threatlens:threatlens@localhost:5432/threatlens_test

# ── Data sources ─────────────────────────────────────────────────────────────
# Free key, arrives by email: https://nvd.nist.gov/developers/request-an-api-key
# Optional, but raises the rate limit from 5 req/30s to 50 req/30s.
NVD_API_KEY=

# ── LLM provider ─────────────────────────────────────────────────────────────
# anthropic | openai | gemini | groq | deepseek | qwen | kimi
THREATLENS_PROVIDER=anthropic
THREATLENS_MODEL=claude-opus-5

# Only the key for the provider you selected above is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
